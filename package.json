{
  "name": "db-access-receipts-site",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.ts",
    "test": "cargo test && npm run test:site && npm run test:browser",
    "test:site": "vitest run",
    "test:browser": "playwright test",
    "build": "npm run build:site",
    "build:site": "tsc --noEmit && vite build --config vite.config.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "1.58.2",
    "@types/node": "^24.3.0",
    "typescript": "^5.9.2",
    "playwright-core": "1.58.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
